@page
@model AndenStemesterEksamensProjekt.Pages.Dashboard.DashboardModel
 <!--Lavet af:  -->
 <!-- Sophie  -->
<div class="container my-5">
    <h1 class="mb-4">Profilside</h1>

    <!-- User Information Card -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Bruger Information</h2>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <p class="mb-1"><strong>Bruger ID:</strong></p>
                    <p class="text-muted">@Model.CurrentUser?.Uid</p>
                </div>
                <div class="col-md-6 mb-3">
                    <p class="mb-1"><strong>Rolle:</strong></p>
                    <p class="text-muted">@Model.CurrentUser?.Role</p>
                </div>
                <div class="col-md-6 mb-3">
                    <p class="mb-1"><strong>Seneste login:</strong></p>
                    <p class="text-muted">@Model.CurrentUser?.LastLogin?.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="col-md-6 mb-3">
                    <p class="mb-1"><strong>Konto oprettet:</strong></p>
                    <p class="text-muted">@Model.CurrentUser?.CreatedAt.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Profile Information Card -->
    @if (Model.CurrentProfile != null)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h2 class="mb-0">Profil Information</h2>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <p class="mb-1"><strong>Navn:</strong></p>
                        <p class="text-dark">@Model.CurrentProfile.Navn</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <p class="mb-1"><strong>Mobil nr.:</strong></p>
                        <p class="text-dark">@Model.CurrentProfile.MobilNr</p>
                    </div>
                    <div class="col-12 mb-3">
                        <p class="mb-1"><strong>Adresse:</strong></p>
                        <p class="text-dark">@Model.CurrentProfile.Adresse</p>
                    </div>
                    <div class="col-12">
                        <small class="text-muted">Profil oprettet: @Model.CurrentProfile.CreatedAt.ToString("dd/MM/yyyy")</small>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">Ingen profil information fundet</h4>
            <p>Du har endnu ikke oprettet en profil. Opret en nu for at få adgang til flere funktioner.</p>
            <a href="/Profile/Create" class="btn btn-primary">Opret profil</a>
        </div>
    }

    <!-- Teams Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Mine Hold</h2>
        </div>
        <div class="card-body">
            @if (Model.CurrentUser?.Role == "planner" || Model.CurrentUser?.Role == "admin")
            {
                <div class="mb-3">
                    <a href="/Teams/Create" class="btn btn-success">Opret nyt hold</a>
                    <a href="/Teams/Manage" class="btn btn-success">Administrer hold</a>
                </div>
                <hr />
            }

            @if (Model.Teams.Any())
            {
                <div class="row g-3">
                    @foreach (var team in Model.Teams)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border-light">
                                <div class="card-body">
                                    <h5 class="card-title text-dark">@team.Name</h5>
                                    @if (!string.IsNullOrEmpty(team.Description))
                                    {
                                        <p class="card-text text-muted">@team.Description</p>
                                    }
                                    <small class="text-muted d-block mt-2">Oprettet: @team.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-secondary" role="alert">
                    <p class="mb-0">Du er ikke medlem af nogen hold endnu.</p>
                </div>
            }
        </div>
    </div>
</div>
