@page
@model AndenStemesterEksamensProjekt.Pages.Dashboard.MyTeamsModel
@{
    ViewData["Title"] = "Mine Hold";
}
 <!--Lavet af:  -->
 <!-- Emil  -->
<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2>Mine Hold</h2>
            
            @if (Model.CurrentUser != null)
            {
                <div class="alert alert-info mb-4">
                    <strong>Bruger:</strong> @Model.CurrentUser.FirstName @Model.CurrentUser.LastName (@Model.CurrentUser.Email)<br />
                    <strong>Rolle:</strong> @Model.CurrentUser.Role
                </div>
            }

            @if (Model.Teams.Count == 0)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-info-circle"></i> Du er ikke medlem af nogen hold endnu.
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var team in Model.Teams)
                    {
                        <div class="col-md-6 mb-3">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0">@team.Name</h5>
                                </div>
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(team.Description))
                                    {
                                        <p class="card-text">@team.Description</p>
                                    }
                                    else
                                    {
                                        <p class="card-text text-muted"><em>Ingen beskrivelse</em></p>
                                    }
                                    
                                    <hr />
                                    
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="bi bi-calendar"></i> Oprettet: @team.CreatedAt.ToString("dd/MM/yyyy")
                                        </small>
                                        <a asp-page="/Teams/Details" asp-route-id="@team.Id" class="btn btn-sm btn-primary">
                                            Se detaljer
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                
                <div class="mt-3">
                    <p class="text-muted">
                        <strong>Total:</strong> @Model.Teams.Count hold
                    </p>
                </div>
            }
            
            <div class="mt-4">
                <a asp-page="/Dashboard/Profil" class="btn btn-success">
                    <i class="bi bi-arrow-left"></i> Tilbage til Profil
                </a>
            </div>
        </div>
    </div>
</div>
