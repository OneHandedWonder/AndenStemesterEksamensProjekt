<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zealand Eksamens Oversigt</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/AndenStemesterEksamensProjekt.styles.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="~/images/Zealand_logo_black_RGB_1600px_72dpi.png" alt="Zealand Logo" style="height: 40px;" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav flex-grow-1">
                        @if (Context.Session.GetString ("UserRole") == null)
                        {

                        } else {
                        <li class="nav-item">
                            <a class="btn btn-outline-dark mx-1" asp-area="" asp-page="/Index">Forside</a>
                        </li>
                        }

                        @if (Context.Session.GetInt32("UserId") != null && Context.Session.GetString("UserRole") != "guest")
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-dark mx-1" asp-area="" asp-page="/Dashboard/Kalender">Eksamens Oversigt</a>
                            </li>
                        }
                        @if (Context.Session.GetInt32("UserId") != null && (Context.Session.GetString("UserRole") == "Planner" || Context.Session.GetString("UserRole") == "Admin"))
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-dark mx-1" asp-area="" asp-page="/Teams/Manage">Hold</a>
                            </li>
                        }
                    </ul>
                    @if (Context.Session.GetInt32("UserId") == null)
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="btn btn-dark" asp-area="" asp-page="/login">Login</a>
                            </li>
                        </ul>
                    }
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="btn btn-outline-dark dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Context.Session.GetString("UserEmail")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Dashboard/Profil">Profil</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Dashboard/MyTeams">Mine Hold</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/logout">Log ud</a></li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AndenStemesterEksamensProjekt - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
