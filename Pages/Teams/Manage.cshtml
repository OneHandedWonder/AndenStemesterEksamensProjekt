@page
@model AndenStemesterEksamensProjekt.Pages.Teams.ManageModel
@{
    ViewData["Title"] = "Hold Oversigt";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="bi bi-people"></i> Hold Oversigt
                </h2>
                @if (Model.CurrentUserRole == "planner" || Model.CurrentUserRole == "admin")
                {
                    <a asp-page="/Teams/Create" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Opret Nyt Hold
                    </a>
                }
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn btn-danger" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn btn-danger" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model.Teams.Any())
            {
                <div class="row">
                    @foreach (var team in Model.Teams)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <i class="bi bi-people-fill text-primary"></i> @team.Name
                                    </h5>
                                    
                                    @if (!string.IsNullOrEmpty(team.Description))
                                    {
                                        <p class="card-text text-muted">@team.Description</p>
                                    }

                                    <div class="mt-3">
                                        <small class="text-muted">
                                            <i class="bi bi-person"></i> @team.UserTeams.Count medlemmer
                                        </small>
                                    </div>

                                    <div class="mt-3">
                                        <a asp-page="/Teams/Details" asp-route-id="@team.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Se detaljer
                                        </a>
                                        
                                        @if (Model.CurrentUserRole == "planner" || Model.CurrentUserRole == "admin")
                                        {
                                            <a asp-page="/Teams/Edit" asp-route-id="@team.Id" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-pencil"></i> Rediger
                                            </a>
                                            
                                            <form method="post" asp-page-handler="Delete" asp-route-teamId="@team.Id" 
                                                  style="display:inline;" 
                                                  onsubmit="return confirm('Er du sikker på at du vil slette dette hold? Alle medlemmer vil blive fjernet.');">
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash"></i> Slet
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                                <div class="card-footer text-muted">
                                    <small>Oprettet: @team.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people" style="font-size: 4rem; color: #ddd;"></i>
                    <p class="mt-3 text-muted">Ingen hold oprettet endnu.</p>
                    @if (Model.CurrentUserRole == "planner" || Model.CurrentUserRole == "admin")
                    {
                        <a asp-page="/Teams/Create" class="btn btn-success mt-2">
                            <i class="bi bi-plus-circle"></i> Opret Dit Første Hold
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
