@page
@model AndenStemesterEksamensProjekt.Pages.Dashboard.KalenderModel
@{
    ViewData["Title"] = "Kalender";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-4">📅 Min Kalender</h2>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Model.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <!-- Calendar Navigation -->
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="?year=@(Model.CurrentMonth == 1 ? Model.CurrentYear - 1 : Model.CurrentYear)&month=@(Model.CurrentMonth == 1 ? 12 : Model.CurrentMonth - 1)" 
                           class="btn btn-outline-primary">
                            ◀ Forrige måned
                        </a>
                        <h4 class="mb-0">@Model.CurrentMonthName</h4>
                        <a href="?year=@(Model.CurrentMonth == 12 ? Model.CurrentYear + 1 : Model.CurrentYear)&month=@(Model.CurrentMonth == 12 ? 1 : Model.CurrentMonth + 1)" 
                           class="btn btn-outline-primary">
                            Næste måned ▶
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Events List -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Events i @Model.CurrentMonthName</h5>
                </div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    @if (Model.Events.Any())
                    {
                        @foreach (var evt in Model.Events)
                        {
                            <div class="card mb-3 border-start border-4" style="border-left-color: @evt.Color !important;">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="card-title mb-2">@evt.Title</h5>
                                            <p class="text-muted mb-2">
                                                <i class="bi bi-clock"></i>
                                                @if (evt.IsAllDay)
                                                {
                                                    <span>@evt.StartTime.ToString("dd/MM/yyyy") - Hele dagen</span>
                                                }
                                                else
                                                {
                                                    <span>@evt.StartTime.ToString("dd/MM/yyyy HH:mm") - @evt.EndTime.ToString("HH:mm")</span>
                                                }
                                            </p>
                                            @if (!string.IsNullOrEmpty(evt.Location))
                                            {
                                                <p class="text-muted mb-2">
                                                    <i class="bi bi-geo-alt"></i> @evt.Location
                                                </p>
                                            }
                                            @if (!string.IsNullOrEmpty(evt.Description))
                                            {
                                                <p class="card-text">@evt.Description</p>
                                            }
                                        </div>
                                        <form method="post" asp-page-handler="DeleteEvent" onsubmit="return confirm('Er du sikker på at du vil slette denne event?');">
                                            <input type="hidden" name="eventId" value="@evt.EventId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Slet
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x" style="font-size: 3rem;"></i>
                            <p class="mt-3">Ingen events i denne måned</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Add Event Form -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">➕ Tilføj Event</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="CreateEvent">
                        <div class="mb-3">
                            <label asp-for="NewEvent.Title" class="form-label">Titel *</label>
                            <input asp-for="NewEvent.Title" class="form-control" placeholder="F.eks. Møde med team" required />
                            <span asp-validation-for="NewEvent.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewEvent.Description" class="form-label">Beskrivelse</label>
                            <textarea asp-for="NewEvent.Description" class="form-control" rows="3" placeholder="Valgfri beskrivelse"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewEvent.StartTime" class="form-label">Start tidspunkt *</label>
                            <input asp-for="NewEvent.StartTime" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="NewEvent.StartTime" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewEvent.EndTime" class="form-label">Slut tidspunkt *</label>
                            <input asp-for="NewEvent.EndTime" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="NewEvent.EndTime" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewEvent.Location" class="form-label">Lokation</label>
                            <input asp-for="NewEvent.Location" class="form-control" placeholder="F.eks. Mødelokale A" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewEvent.Color" class="form-label">Farve</label>
                            <input asp-for="NewEvent.Color" type="color" class="form-control form-control-color" />
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="NewEvent.IsAllDay" type="checkbox" class="form-check-input" />
                            <label asp-for="NewEvent.IsAllDay" class="form-check-label">
                                Hele dagen
                            </label>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-plus-circle"></i> Opret Event
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
