@page
@model AndenStemesterEksamensProjekt.Pages.Dashboard.KalenderModel
@{
    ViewData["Title"] = "Min Oversigt";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-4">Min Oversigt</h2>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Model.SuccessMessage
                    <button type="button" class="btn btn-danger" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @Model.ErrorMessage
                    <button type="button" class="btn btn-danger" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <!-- Calendar Navigation -->
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="?year=@(Model.CurrentMonth == 1 ? Model.CurrentYear - 1 : Model.CurrentYear)&month=@(Model.CurrentMonth == 1 ? 12 : Model.CurrentMonth - 1)" 
                           class="btn btn-outline-primary">
                            ◀ Forrige måned
                        </a>
                        <h4 class="mb-0">@Model.CurrentMonthName</h4>
                        <a href="?year=@(Model.CurrentMonth == 12 ? Model.CurrentYear + 1 : Model.CurrentYear)&month=@(Model.CurrentMonth == 12 ? 1 : Model.CurrentMonth + 1)" 
                           class="btn btn-outline-primary">
                            Næste måned ▶
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Events List -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Events i @Model.CurrentMonthName</h5>
                </div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    @if (Model.Events.Any())
                    {
                        @foreach (var evt in Model.Events)
                        {
                            <div class="card mb-3 border-start border-4" style="border-left-color: @evt.Color !important;">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <h5 class="card-title mb-0">@evt.Title</h5>
                                                @if (evt.UserId != Model.CurrentUserId)
                                                {
                                                    <span class="badge bg-info">
                                                        <i class="bi bi-people"></i> Deltager
                                                    </span>
                                                }
                                            </div>
                                            <p class="text-muted mb-2">
                                                        <span>
													      Afleveringstidspunkt:
                                                        </span>
                                                <span>@evt.SubmissionTime.ToString("dd/MM/yyyy HH:mm")</span>

                                            </p>
                                            <p class="text-muted mb-2">
                                                <i class="bi bi-clock"></i>
                                                <span>
                                                    Eksamenstidspunkt:
                                                </span>
                                                @if (evt.IsAllDay)
                                                {
                                                    <span>@evt.StartTime.ToString("dd/MM/yyyy") - Hele dagen</span>
                                                }
                                                else
                                                {
                                                    <span>@evt.StartTime.ToString("dd/MM/yyyy HH:mm") - @evt.EndTime.ToString("HH:mm")</span>
                                                }
                                            </p>
                                            @if (!string.IsNullOrEmpty(evt.Type))
                                            {
                                                <p class="text-muted mb-2">
                                                    <i class="bi bi-file-text"></i>
                                                    @switch(evt.Type)
                                                    {
                                                        case "written":
                                                            <span>Skriftlig eksamen</span>
                                                            break;
                                                        case "oral":
                                                            <span>Mundtlig eksamen</span>
                                                            break;
                                                        case "oral+written":
                                                            <span>Mundtlig + Skriftlig eksamen</span>
                                                            break;
                                                        case "project":
                                                            <span>Projekt</span>
                                                            break;
                                                        default:
                                                            <span>@evt.Type</span>
                                                            break;
                                                    }
                                                </p>
                                            }
                                            @if (!string.IsNullOrEmpty(evt.Location))
                                            {
                                                <p class="text-muted mb-2">
                                                    <i class="bi bi-geo-alt"></i> @evt.Location
                                                </p>
                                            }
                                            @if (!string.IsNullOrEmpty(evt.Description))
                                            {
                                                <p class="card-text">@evt.Description</p>
                                            }
                                            
                                            @* Show participants *@
                                            @if (Model.EventParticipants.ContainsKey(evt.EventId) && Model.EventParticipants[evt.EventId].Any())
                                            {
                                                <div class="mt-3">
                                                    <strong class="text-muted">Deltagere:</strong>
                                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                                        @foreach (var participant in Model.EventParticipants[evt.EventId])
                                                        {
                                                            <span class="badge bg-@(participant.Status == "accepted" ? "success" : participant.Status == "declined" ? "danger" : "secondary")">
                                                                @participant.User?.FirstName @participant.User?.LastName <small>(@participant.User?.Role - @participant.User?.Email)</small>
                                                                <form method="post" asp-page-handler="RemoveParticipant" style="display:inline;" onsubmit="return confirm('Fjern denne deltager?');">
                                                                    <input type="hidden" name="eventId" value="@evt.EventId" />
                                                                    <input type="hidden" name="participantUserId" value="@participant.UserId" />
                                                                    @if (Model.CurrentUserRole == "planner" || Model.CurrentUserRole == "admin")
                                                                    {
                                                                        <button type="submit" class="btn-close btn-close-white" style="font-size: 0.6rem;" aria-label="Fjern"></button>
                                                                    }
                                                                </form>
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            
                                            @* Add participant form - only show if user is planner or admin *@
                                            @if (Model.CurrentUserRole == "planner" || Model.CurrentUserRole == "admin")
                                            {
                                                <div class="mt-3">
                                                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addParticipants@(evt.EventId)" aria-expanded="false">
                                                        <i class="bi bi-person-plus"></i> Tilføj deltagere
                                                    </button>
                                                    <div class="collapse mt-2" id="addParticipants@(evt.EventId)">
                                                    <form method="post" asp-page-handler="AddParticipant">
                                                        <input type="hidden" name="eventId" value="@evt.EventId" />
                                                        <div class="border rounded p-2" style="max-height: 150px; overflow-y: auto;">
                                                            @{
                                                                var availableUsers = Model.AllUsers.Where(u => 
                                                                    !Model.EventParticipants.ContainsKey(evt.EventId) || 
                                                                    !Model.EventParticipants[evt.EventId].Any(p => p.UserId == u.Uid)
                                                                ).ToList();
                                                            }
                                                            @if (availableUsers.Any())
                                                            {
                                                                @foreach (var user in availableUsers)
                                                                {
                                                                    <div class="form-check">
                                                                        <input class="form-check-input" type="checkbox" name="participantUserId" value="@user.Uid" id="event@(evt.EventId)User@(user.Uid)" />
                                                                        <label class="form-check-label" for="event@(evt.EventId)User@(user.Uid)">
                                                                            @user.FirstName @user.LastName <small class="text-muted">(@user.Role - @user.Email)</small>
                                                                        </label>
                                                                    </div>
                                                                }
                                                                <button type="submit" class="btn btn-sm btn-success mt-2 w-100">
                                                                    <i class="bi bi-check-circle"></i> Tilføj valgte
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <p class="text-muted mb-0">Alle brugere er allerede deltagere</p>
                                                            }
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                        </div>
                                        
                                        @* Only show delete button if user is planner or admin *@
                                        @if (Model.CurrentUserRole == "planner" || Model.CurrentUserRole == "admin")
                                        {
                                            <form method="post" asp-page-handler="DeleteEvent" onsubmit="return confirm('Er du sikker på at du vil slette dette event?');">
                                                <input type="hidden" name="eventId" value="@evt.EventId" />
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash"></i> Slet
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x" style="font-size: 3rem;"></i>
                            <p class="mt-3">Ingen events i denne måned</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Add Event Form -->
        @if (Model.CurrentUserRole == "planner" || Model.CurrentUserRole == "admin")
        {
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Tilføj Event</h5>
                    </div>
                    <div class="card-body">
                    <form method="post" asp-page-handler="CreateEvent">
                        <div class="mb-3">
                            <label asp-for="NewEvent.Title" class="form-label">Titel *</label>
                            <input asp-for="NewEvent.Title" class="form-control" placeholder="F.eks. Møde med team" required />
                            <span asp-validation-for="NewEvent.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewEvent.Description" class="form-label">Beskrivelse</label>
                            <textarea asp-for="NewEvent.Description" class="form-control" rows="3" placeholder="Valgfri beskrivelse"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewEvent.Type" class="form-label">Eksamenstype *</label>
                            <select asp-for="NewEvent.Type" class="form-select" required>
                                <option value="written">Skriftlig</option>
                                <option value="oral">Mundtlig</option>
                                <option value="oral+written">Mundtlig + Skriftlig</option>
                                <option value="project">Projekt</option>
                            </select>
                            <span asp-validation-for="NewEvent.Type" class="text-danger"></span>
                        </div>

                            <div class="mb-3">
                                <label asp-for="NewEvent.SubmissionTime" class="form-label">Afleveringstidspunkt*</label>
                                <input asp-for="NewEvent.SubmissionTime" type="datetime-local" class="form-control" required />
                                <span asp-validation-for="NewEvent.SubmissionTime" class="text-danger"></span>
                            </div>

                        <div class="mb-3">
                            <label asp-for="NewEvent.StartTime" class="form-label">Start tidspunkt *</label>
                                <input asp-for="NewEvent.StartTime" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="NewEvent.StartTime" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewEvent.EndTime" class="form-label">Slut tidspunkt *</label>
                            <input asp-for="NewEvent.EndTime" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="NewEvent.EndTime" class="text-danger"></span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.InlineErrorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                @Model.InlineErrorMessage
                                <button type="button" class="btn btn-danger" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="NewEvent.Location" class="form-label">Lokation</label>
                            <input asp-for="NewEvent.Location" class="form-control" placeholder="F.eks. Mødelokale A" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewEvent.Color" class="form-label">Farve</label>
                            <input asp-for="NewEvent.Color" type="color" class="form-control form-control-color" />
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="NewEvent.IsAllDay" type="checkbox" class="form-check-input" />
                            <label asp-for="NewEvent.IsAllDay" class="form-check-label">
                                Hele dagen
                            </label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Deltagere</label>
                            <div class="border rounded p-2" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var user in Model.AllUsers)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedParticipants" value="@user.Uid" id="newEventUser@(user.Uid)" />
                                        <label class="form-check-label" for="newEventUser@(user.Uid)">
                                            <i class="bi bi-person"></i> @user.FirstName @user.LastName <small class="text-muted">(@user.Role - @user.Email)</small>
                                        </label>
                                    </div>
                                }
                            </div>
                            <small class="form-text text-muted">Vælg individuelle deltagere til eventet</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Hold</label>
                            <div class="border rounded p-2" style="max-height: 200px; overflow-y: auto;">
                                @if (Model.AllTeams.Any())
                                {
                                    @foreach (var team in Model.AllTeams)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="SelectedTeams" value="@team.Id" id="newEventTeam@(team.Id)" />
                                            <label class="form-check-label" for="newEventTeam@(team.Id)">
                                                <i class="bi bi-people-fill text-primary"></i> @team.Name 
                                                <small class="text-muted">(@team.UserTeams.Count medlemmer)</small>
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Ingen hold tilgængelige</p>
                                }
                            </div>
                            <small class="form-text text-muted">Vælg hold - alle medlemmer vil blive tilføjet</small>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-plus-circle"></i> Opret Event
                        </button>
                    </form>
                </div>
            </div>
        </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
